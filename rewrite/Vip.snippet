# >>>>>>>>>> ✅ 会员功能解锁 ✅ <<<<<<<<<

# AdGuard会员
;hostname = mobile-api.adguard.org
^https?:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt url script-response-body https://raw.githubusercontent.com/yqc007/QuantumultX/master/AdGuardProCrack.js

# Spotify会员
;hostname = spclient.wg.spotify.com, *spclient.spotify.com
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ url script-request-header https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-qx-header.js
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ url script-response-body https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-proto.js
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/ url script-request-header https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js

# 稿定设计v4.56
;hostname = qiye.gaoding.com
# 屏蔽升级
^https:\/\/qiye\.gaoding\.com\/api\/v3\/oc\/(gaoding\/app\/upgrade|app\/releases) url reject-dict
# 开屏广告
^https:\/\/qiye\.gaoding\.com\/api\/v3\/oc\/v2\/delivery-pits\/ios-splash\/modules url reject-dict
# 个人中心弹窗
^https:\/\/qiye\.gaoding\.com\/api\/v3\/oc\/delivery-pits\/mine-page-dialog\/modules url reject-dict
# 解锁会员
^https:\/\/qiye\.gaoding\.com\/api\/(structure\/company\/current|ccm\/editors\/risk_materials) url script-response-body https://raw.githubusercontent.com/Newflav/Quantumult-X/main/scripts/gaoding.js

# 百度网盘会员v12.8
;hostname = pan.baidu.com
# 开屏广告
^https?:\/\/pan\.baidu\.com\/api\/getsyscfg url script-response-body https://raw.githubusercontent.com/Newflav/Quantumult-X/main/scripts/baiduwangpan.js
# 设置信息流
^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list url reject-200
# 通用广告
^https?:\/\/pan\.baidu\.com\/rest\/.*\/pcs\/ad url reject-200
# 活动推广
^https?:\/\/pan\.baidu\.com\/act\/api\/activityentry url reject-200
# 解锁会员
^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?app_id url script-response-body https://raw.githubusercontent.com/Newflav/Quantumult-X/main/scripts/baiduwangpan.js

# 扫描全能王会员
;hostname = *.intsig.net, *.camscanner.com
^https:\/\/(open|open-bak)\.camscanner\.com\/sync\/(get_cs_cfg|get_ad_cfg) url reject-dict
^https?:\/\/.*\.(intsig\.net|camscanner\.com) url script-response-body https://raw.githubusercontent.com/Newflav/Quantumult-X/main/scripts/camScanner.js



hostname = mobile-api.adguard.org, spclient.wg.spotify.com, *spclient.spotify.com, qiye.gaoding.com, pan.baidu.com, *.intsig.net, *.camscanner.com